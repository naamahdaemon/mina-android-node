+++ b/crates/cli/src/android_credentials.rs
@@ -0,0 +1,35 @@
+//! Private Android launch input. Secrets never enter clap arguments or env.
+use std::io::{self, Read};
+use zeroize::Zeroizing;
+
+pub fn read_password(reader: &mut impl Read) -> io::Result<Zeroizing<String>> {
+    let mut size = [0u8; 4];
+    reader.read_exact(&mut size)?;
+    let len = u32::from_le_bytes(size) as usize;
+    if len > 16384 { return Err(io::Error::new(io::ErrorKind::InvalidData, "credential frame too large")); }
+    let mut bytes = Zeroizing::new(vec![0u8; len]);
+    reader.read_exact(&mut bytes)?;
+    // The returned password has its own zeroizing allocation; temporary input
+    // is erased even when decoding fails. Never include its content in errors.
+    let text = std::str::from_utf8(&bytes)
+        .map_err(|_| io::Error::new(io::ErrorKind::InvalidData, "invalid credential encoding"))?;
+    Ok(Zeroizing::new(text.to_owned()))
+}
+
+#[cfg(test)]
+mod tests {
+    use super::*;
+    #[test]
+    fn preserves_password_whitespace_and_unicode() {
+        let password = "  mot de passe é  ";
+        let mut frame = (password.len() as u32).to_le_bytes().to_vec();
+        frame.extend_from_slice(password.as_bytes());
+        assert_eq!(read_password(&mut &frame[..]).unwrap().as_str(), password);
+    }
+    #[test]
+    fn rejects_large_truncated_and_invalid_utf8_frames() {
+        for frame in [16385u32.to_le_bytes().to_vec(), vec![3,0,0,0,1], vec![1,0,0,0,255]] {
+            assert!(read_password(&mut &frame[..]).is_err());
+        }
+    }
+}
